<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NeuroTune.Agent</AssemblyName>
    <RootNamespace>NeuroTune.Agent</RootNamespace>
    <Version>0.7.0-alpha.1</Version>
    <Authors>PrimeBuild</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PrimeBuild-pc/NeuroTune</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NeuroTune.Core\NeuroTune.Core.csproj" />
    <None Include="NeuroTuneLatency.wprp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
