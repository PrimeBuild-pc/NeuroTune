<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NeuroTune.Core</AssemblyName>
    <RootNamespace>NeuroTune</RootNamespace>
    <Version>0.8.0-alpha.5</Version>
    <Authors>PrimeBuild</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PrimeBuild-pc/NeuroTune</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\component-baselines.v1.json" />
    <EmbeddedResource Include="system-one-worker.py" />
    <EmbeddedResource Include="..\..\presets\*.md" LogicalName="NeuroTune.presets.%(Filename).md" />
    <EmbeddedResource Include="..\..\scripts\clm-requirements.txt" LogicalName="NeuroTune.clm-requirements.txt" />
    <Content Include="..\..\ui\src-tauri\agent\pi\*" Link="pi\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="NeuroTune.Tests" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
  </ItemGroup>
</Project>
