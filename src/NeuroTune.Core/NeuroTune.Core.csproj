<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NeuroTune.Core</AssemblyName>
    <RootNamespace>NeuroTune</RootNamespace>
    <Version>0.7.0-alpha.1</Version>
    <Authors>PrimeBuild</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/PrimeBuild-pc/NeuroTune</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Data\component-baselines.v1.json" />
    <InternalsVisibleTo Include="NeuroTune.Tests" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.5" />
  </ItemGroup>
</Project>
