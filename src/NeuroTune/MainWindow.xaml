<Window x:Class="NeuroTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="NeuroTune" Icon="Assets/NeuroTune.ico" Height="840" Width="1240" MinHeight="700" MinWidth="1000"
        Background="#080D19" Foreground="#F4F7FB" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#111827"/>
        <SolidColorBrush x:Key="SurfaceRaised" Color="#172033"/>
        <SolidColorBrush x:Key="Border" Color="#26334A"/>
        <SolidColorBrush x:Key="Muted" Color="#98A6BA"/>
        <SolidColorBrush x:Key="Accent" Color="#6D5DFB"/>
        <SolidColorBrush x:Key="AccentHover" Color="#7E70FF"/>
        <SolidColorBrush x:Key="Success" Color="#32C48D"/>
        <SolidColorBrush x:Key="Warning" Color="#F4B740"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,6,10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="40"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHover}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#25314A"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B8425A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,14"/><Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="#E8EDF5"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5,0,14"/><Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111827"/><Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource SurfaceRaised}"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F7FB"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Accent}" Margin="0,0,14,0">
                    <TextBlock Text="N" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="NeuroTune" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="AI-guided Windows tuning with a reversible safety boundary" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Text="Alpha" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="AdminText" Text="Administrator session" HorizontalAlignment="Right" Foreground="{StaticResource Success}" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <Border x:Name="RecoveryBanner" Grid.Row="1" Background="#3A2E17" BorderBrush="#6E5624" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Review recovery" Click="OpenRecovery_Click" Margin="12,0,0,0"/>
                <TextBlock x:Name="RecoveryText" VerticalAlignment="Center" Foreground="#FFD98A" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="0,18,0,0">
            <TabItem Header="1  SETUP">
                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Connect your AI provider" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Your key is encrypted locally with Windows DPAPI. NeuroTune never sends it anywhere except the selected provider." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,20"/>
                            <TextBlock Text="Provider" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ProviderCombo" automation:AutomationProperties.Name="AI provider" SelectionChanged="ProviderCombo_SelectionChanged"/>
                            <TextBlock Text="Model" FontWeight="SemiBold"/>
                            <ComboBox x:Name="ModelCombo" automation:AutomationProperties.Name="AI model" IsEditable="True" IsTextSearchEnabled="True" ToolTip="Select a discovered model or enter its exact ID"/>
                            <TextBlock Text="API key" FontWeight="SemiBold"/>
                            <PasswordBox x:Name="ApiKeyBox" automation:AutomationProperties.Name="Provider API key" ToolTip="Encrypted for the current Windows user"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SaveButton" Content="Save securely" Click="SaveSettings_Click"/>
                                <Button x:Name="LoadModelsButton" Style="{StaticResource SecondaryButton}" Content="Test connection &amp; load models" Click="LoadModels_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ProviderStatusText" Text="Not connected yet" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Safety boundary" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="✓ The AI can only select built-in actions" Margin="0,14,0,6"/>
                                <TextBlock Text="✓ Unknown actions and scripts are rejected" Margin="0,6"/>
                                <TextBlock Text="✓ Backups are mandatory before changes" Margin="0,6"/>
                                <TextBlock Text="✓ Every applied value is recorded for rollback" Margin="0,6"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Before you continue" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Enable System Protection on the Windows drive. The apply step fails closed when NeuroTune cannot verify a new restore point." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="2  SCAN">
                <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Understand this PC" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Local scan first. Nothing is sent until you request an AI diagnosis." Foreground="{StaticResource Muted}"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ScanButton" Style="{StaticResource SecondaryButton}" Content="Scan this PC" Click="Scan_Click"/>
                            <Button x:Name="AnalyzeButton" Content="Run AI diagnosis" Click="Analyze_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="WINDOWS" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="OsMetricText" Text="Not scanned" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuMetricText" Text="Not scanned" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="8,0"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="MemoryMetricText" Text="Not scanned" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="GPU" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="GpuMetricText" Text="Not scanned" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <DockPanel><TextBlock DockPanel.Dock="Top" Text="Sanitized profile sent to the provider" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBox x:Name="ProfileTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" BorderThickness="0" FontFamily="Consolas" FontSize="12"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                            <DockPanel><TextBlock DockPanel.Dock="Top" Text="AI diagnosis" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBox x:Name="DiagnosisTextBox" IsReadOnly="True" Text="Run a local scan, then request a diagnosis." TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0" BorderThickness="0"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="3  REVIEW">
                <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Review every change" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Compatibility and current state are checked locally. The AI never bypasses this screen." Foreground="{StaticResource Muted}"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,10,8"/><ComboBox x:Name="PresetCombo" Width="210" SelectionChanged="PresetCombo_SelectionChanged"/></StackPanel>
                    </Grid>
                    <ListView x:Name="ActionsList" automation:AutomationProperties.Name="Compatible optimization actions" Grid.Row="1" Margin="0,14,0,10" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style></ListView.ItemContainerStyle>
                        <ListView.ItemTemplate><DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,9" Padding="16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanApply}" Click="ActionSelection_Changed"/>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,20,5"/><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#C9D2E1" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding RecommendationLabel}" Foreground="{StaticResource Success}" FontWeight="SemiBold"/><TextBlock Text="{Binding Availability}" Foreground="{StaticResource Warning}" Margin="0,5,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding CurrentValue, StringFormat=Current: {0}}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/><TextBlock Text="{Binding RiskLabel, StringFormat=Risk: {0}}" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="ActionCountText" Text="0 actions selected" FontWeight="SemiBold"/><TextBlock Text="A verified restore point and Registry backups are required before execution." Foreground="{StaticResource Muted}"/></StackPanel>
                        <Button x:Name="ApplyButton" Grid.Column="1" Content="Create backup &amp; apply" Click="Apply_Click" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="4  RESULTS &amp; RESTORE">
                <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Results and recovery" FontSize="22" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="LATEST OPERATION" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ResultsSummaryText" Text="No operation completed in this session." TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="OBSERVATIONAL SNAPSHOT" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="ComparisonText" Text="Before/after telemetry will appear here. It is not a benchmark." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DockPanel><TextBlock DockPanel.Dock="Top" Text="Operation history" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ListView x:Name="HistoryList" automation:AutomationProperties.Name="Optimization operation history" Background="#0B1220" BorderThickness="0" DisplayMemberPath="Display"/>
                        </DockPanel>
                    </Border>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="Refresh history" Click="RefreshHistory_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="Restore selected operation" Click="Rollback_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready. Start by connecting a provider or scanning this PC." Foreground="#C7D0DE" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <ProgressBar x:Name="BusyProgress" Grid.Column="1" Width="150" Height="6" IsIndeterminate="True" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
